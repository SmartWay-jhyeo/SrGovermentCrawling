# 이 파일은 설정 양식입니다. 구현된 프로그램과 실제 API 검증 결과가 아닙니다.
# .env로 복사해 사용자가 로컬 편집기로 입력하세요. 실제 키를 채팅이나 Git에 올리지 마세요.
# 공공데이터포털의 Decoding 원문 키를 입력하고 클라이언트가 한 번만 인코딩합니다.
DATA_GO_KR_SERVICE_KEY=
ALLOW_LIVE_API=false

# 다음 값은 보수적인 내부 안전예산입니다. 제공기관이 승인한 쿼터가 아닙니다.
# 실호출은 위 허용값과 CLI --live를 모두 요구하도록 구현합니다.
LIVE_MAX_CALLS_PER_RUN=100
LIVE_MAX_CALLS_PER_DAY=100
REQUEST_INTERVAL_SECONDS=1.0
HTTP_TIMEOUT_SECONDS=30
RETRY_MAX_ATTEMPTS=3

# 실제 데이터 저장소. 데모 데이터는 별도 경로를 사용해야 합니다.
DATA_MODE=real
DATABASE_PATH=.local/real/bidloc.sqlite3
RAW_RESPONSE_DIR=.local/real/raw
EXPORT_DIR=.local/real/exports
LOG_DIR=.local/logs
APP_HOST=127.0.0.1
APP_PORT=8501

# --- P0 구현에서 추가한 선택 설정 (기존 항목은 위에 그대로 유지) ---
# 키 형식: decoded(기본, 포털의 Decoding 키) 또는 encoded(이미 URL 인코딩된 Encoding 키). encoded면 다시 인코딩하지 않습니다.
DATA_GO_KR_SERVICE_KEY_FORMAT=decoded
# verify-api 로컬 보고서 경로(실데이터 포함, Git 제외)와 응답 본문 최대 크기(바이트)
REPORT_DIR=.local/real/reports
MAX_RESPONSE_BYTES=20971520

# 백필·recall 측정의 일일 내부 안전한도. 기본은 OpenAPI 서비스 단위 합산(포털 표기: 개발계정 서비스당 1,000회/일).
# BACKFILL_QUOTA_SCOPE=operation은 오퍼레이션별 독립 할당이 실측으로 확인된 경우에만 쓴다.
BACKFILL_MAX_CALLS_PER_SERVICE_PER_DAY=800
BACKFILL_QUOTA_SCOPE=service
